AKSHARE_API_KEY=__SAME_AS_QUOTE_HTTP_API_KEY__
AKSHARE_CACHE_TTL_SECONDS=10
AKSHARE_MAX_STALE_SECONDS=30
AKSHARE_SEARCH_LIMIT=20
AKSHARE_UPSTREAM_TIMEOUT_SECONDS=50
# 港美股目录在东财不可用时会走新浪分页降级；该值仅控制整批目录任务，不放宽单次请求超时。
AKSHARE_CATALOG_TIMEOUT_SECONDS=900
AKSHARE_SINGLE_CACHE_MAX_ENTRIES=1000
# 密码含特殊字符时需先进行 URL 编码；单股最后成功行情通过此 Redis 永久保留。
AKSHARE_REDIS_URL=redis://:__URL_ENCODED_REDIS_PASSWORD__@127.0.0.1:6379/0
