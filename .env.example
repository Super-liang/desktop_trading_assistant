POSTGRES_DB=trading_assistant
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me-for-production
DB_URL=jdbc:postgresql://localhost:5432/trading_assistant
DB_USERNAME=trading
DB_PASSWORD=change-me-for-production
JWT_SECRET=dev-only-secret-must-be-at-least-32-bytes-long
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
VITE_API_URL=http://localhost:8080
# 获得 PC 展示/终端分发授权后启用；桥接契约见 docs/architecture.md
QUOTE_HTTP_ENABLED=false
QUOTE_HTTP_BASE_URL=
QUOTE_HTTP_API_KEY=
QUOTE_HTTP_PRIORITY=10
# AKShare 仅用于本地非商业研究；与 QUOTE_HTTP_API_KEY 配置为同一个随机值
AKSHARE_API_KEY=
AKSHARE_CACHE_TTL_SECONDS=10
AKSHARE_MAX_STALE_SECONDS=30
AKSHARE_SEARCH_LIMIT=20
